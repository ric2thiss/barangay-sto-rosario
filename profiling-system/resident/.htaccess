# ══════════════════════════════════════════════════════════════
#  .htaccess — Barangay Sto. Rosario Security Configuration
#  RENAME THIS FILE TO: .htaccess
#  Place one in your project root AND one in /officials/ folder
# ══════════════════════════════════════════════════════════════

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "same-origin"
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Block direct access to sensitive files ────────────────────
<FilesMatch "(connection\.php|\.sql|\.env|\.log|\.bak)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Prevent directory listing ─────────────────────────────────
Options -Indexes

# ── PHP errors off in production ─────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# ── Force HTTPS (uncomment when SSL certificate is active) ────
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ══════════════════════════════════════════════════════════════
#  ALSO create /officials/uploads/.htaccess with this content:
#  (Prevents uploaded images from being executed as PHP)
# ══════════════════════════════════════════════════════════════
#
#  <FilesMatch "\.php$">
#      Order Allow,Deny
#      Deny from all
#  </FilesMatch>
#  Options -ExecCGI
#  AddType text/plain .php .php5 .phtml